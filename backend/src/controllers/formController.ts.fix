import { Request, Response } from 'express';
import NamingDedicationForm from '../models/NamingDedicationForm';
import CourtshipForm from '../models/CourtshipForm';
import BurialForm from '../models/BurialForm';
import mongoose, { Types } from 'mongoose';
import { IUser } from '../models/User';

// Extended Request type with properly typed user
interface AuthRequest extends Request {
  user?: IUser;
}

export const getAllSubmissions = async (req: Request, res: Response) => {
  try {
    // Populate submittedBy field to get user information
    const namingDedicationForms = await NamingDedicationForm.find()
      .populate('submittedBy', 'name email')
      .sort({ createdAt: -1 });
      
    const courtshipForms = await CourtshipForm.find()
      .populate('submittedBy', 'name email')
      .sort({ createdAt: -1 });
      
    const burialForms = await BurialForm.find()
      .populate('submittedBy', 'name email')
      .sort({ createdAt: -1 });

    res.status(200).json({
      success: true,
      data: {
        namingDedication: namingDedicationForms,
        courtship: courtshipForms,
        burial: burialForms,
      },
    });
  } catch (error) {
    console.error('Error fetching submissions:', error);
    res.status(500).json({ success: false, message: 'Server Error' });
  }
};

// Update status for naming & dedication forms
export const updateNamingDedicationStatus = async (req: AuthRequest, res: Response) => {
  try {
    const { id } = req.params;
    const { status } = req.body;
    
    if (!mongoose.Types.ObjectId.isValid(id)) {
      return res.status(400).json({ success: false, message: 'Invalid form ID' });
    }
    
    if (!status || !['pending', 'approved', 'rejected', 'completed'].includes(status)) {
      return res.status(400).json({ success: false, message: 'Invalid status value' });
    }
    
    const form = await NamingDedicationForm.findById(id);
    
    if (!form) {
      return res.status(404).json({ success: false, message: 'Form not found' });
    }
    
    form.status = status;
    if (req.user && req.user._id) {
      // Convert string ID to ObjectId
      const processedById = new Types.ObjectId(req.user._id.toString());
      form.processedBy = processedById;
    }
    await form.save();
    
    res.status(200).json({
      success: true,
      data: form,
      message: 'Status updated successfully'
    });
  } catch (error) {
    console.error('Error updating naming & dedication status:', error);
    res.status(500).json({ success: false, message: 'Server Error' });
  }
};

